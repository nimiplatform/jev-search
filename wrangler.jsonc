{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-search",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Self-hosters: remove this route to use workers.dev, or set your own domain.
  "routes": [{ "pattern": "jev.s1.dev", "custom_domain": true }],
  "vars": {
    "SEARCH1API_BASE_URL": "https://api.search1api.com",
    "TYPESAFE_MODEL": "jev-latest"
  },
  "secrets": { "required": ["SEARCH1API_API_KEY", "TYPESAFE_API_KEY"] },
  "ratelimits": [{
    "name": "SEARCH_RATE_LIMIT",
    "namespace_id": "2026091801",
    "simple": { "limit": 30, "period": 60 }
  }],
  // Self-hosters: create a namespace and replace this public resource ID.
  "kv_namespaces": [{ "binding": "CACHE", "id": "ff6092d31fbf4f5999be145d5dd8e84d" }],
  // Optional. Remove this binding to disable search and click analytics.
  "analytics_engine_datasets": [{ "binding": "FEEDBACK", "dataset": "jev_search_feedback" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
